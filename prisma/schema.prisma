generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TemplateType {
  standard
  raphael_medina_subspecialty
  img_vmr
  sunday_fundamentals
  simplicity_in_complexity_vmr
  academy_session
  mainstream_mondays
  custom
}

enum SubmissionStatus {
  awaiting_upload
  submitted
  awaiting_youtube
  ready_to_publish
  published
}

enum PersonRole {
  presenter
  discussant
}

enum PersonLinkType {
  none
  x
  instagram
  custom
}

enum UserRole {
  member
  super_admin
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  role           UserRole @default(member)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Submission {
  id                   String           @id @default(cuid())
  templateType         TemplateType
  title                String
  slug                 String?          @unique
  customTitle          String?
  subspecialty         String?
  residencyProgram     String?
  sessionDate          DateTime
  chiefComplaint       String?
  youtubeUrl           String?
  notes                String?
  status               SubmissionStatus
  publishedAt          DateTime?
  originalFileName     String?
  sanitizedFileName    String?
  fileMimeType         String?
  fileExtension        String?
  storagePath          String?
  thumbnailPath        String?
  thumbnailMimeType    String?
  thumbnailRotation    Int              @default(0)
  uploadConfirmedAt    DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  people               SubmissionPerson[]
}

model SubmissionPerson {
  id            String         @id @default(cuid())
  submissionId  String
  role          PersonRole
  fullName      String
  linkType      PersonLinkType
  handleOrUrl   String?
  normalizedUrl String?
  sortOrder     Int
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  submission    Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, role, sortOrder])
}
