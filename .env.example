# ── Local Development ──
DATABASE_URL="file:./dev.db"
STORAGE_ROOT="./storage"
APP_BASE_URL="http://localhost:3000"

# ── Authentication ──
# Per-user accounts in the User table. The seed script creates a first super admin
# from SEED_ADMIN_EMAIL + SUPER_ADMIN_PASSWORD (or SEED_ADMIN_PASSWORD). After seeding,
# the env vars are no longer used by the app — passwords live in the DB.
# AUTH_SECRET="random-secret-for-cookie-signing"
# SEED_ADMIN_EMAIL="admin@cps.local"
# SUPER_ADMIN_PASSWORD="initial-super-admin-password"

# ── Vercel Production ──
# Turso database
# TURSO_DATABASE_URL="libsql://your-db.turso.io"
# TURSO_AUTH_TOKEN="your-turso-token"

# Cloudflare R2 storage (required in production)
# Create a bucket in the Cloudflare dashboard, generate an R2 API token with
# Object Read & Write, and expose the bucket via a Public URL or custom domain.
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET="cps-vmr-uploads"
# R2_PUBLIC_URL="https://your-bucket-public-url.r2.dev"

# Cron authentication for /api/cron/sweep-orphans
# CRON_SECRET="random-string-for-manual-cron-triggers"
